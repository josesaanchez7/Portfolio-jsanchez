---
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

type Variant = "primary" | "secondary" | "ghost";

/**
 * Enlace (si recibe `href`) o botón (si no) con estilos coherentes. El resto de atributos
 * (aria-*, data-*, download…) se pasan tal cual al elemento.
 */
interface Props extends Omit<HTMLAttributes<"a">, "class" | "target" | "rel"> {
  variant?: Variant;
  icon?: IconName;
  /** Abre en una pestaña nueva (enlaces externos). */
  external?: boolean;
}

const BASE = [
  "inline-flex items-center justify-center gap-[0.55rem] py-[0.7rem]",
  "rounded-sm border text-[0.95rem] leading-[1.2] font-semibold cursor-pointer",
  // Color: `ease` (cambio de estado). Pulsar: encoge un 3 % al instante para que el botón «escuche» al usuario.
  "transition-[background-color,border-color,color,scale,box-shadow] duration-150 ease-[ease]",
  "active:scale-[0.97]",
  "disabled:scale-100 disabled:cursor-not-allowed disabled:opacity-50",
  "[&_svg]:shrink-0",
].join(" ");

const VARIANT: Record<Variant, string> = {
  // Principal: color de marca con resplandor y un destello que lo cruza al pasar el ratón (solo `translate`).
  primary:
    "relative overflow-hidden border-transparent bg-accent px-5 text-accent-contrast shadow-[0_8px_24px_-10px_var(--accent)] hover:bg-accent-hover hover:text-accent-contrast hover:shadow-[0_10px_30px_-8px_var(--accent)] before:pointer-events-none before:absolute before:inset-0 before:-translate-x-full before:bg-[linear-gradient(100deg,transparent_30%,rgba(255,255,255,0.4)_50%,transparent_70%)] before:transition-[translate] before:duration-700 before:ease-out before:content-[''] hover:before:translate-x-full motion-reduce:before:hidden",
  secondary:
    "border-border-strong bg-transparent px-5 text-fg hover:border-accent hover:text-accent",
  ghost: "border-transparent bg-transparent px-2 text-fg-muted hover:text-accent",
};

const { variant = "primary", icon, external, href, ...attributes } = Astro.props;
const className = `${BASE} ${VARIANT[variant]}`;
---

{
  href !== undefined ? (
    <a {...attributes} href={href} class={className} {...(external && { target: "_blank", rel: "noopener noreferrer" })}>
      {icon && <Icon name={icon} />}
      <slot />
    </a>
  ) : (
    <button {...attributes} type="button" class={className}>
      {icon && <Icon name={icon} />}
      <slot />
    </button>
  )
}
