---
import { parseTags } from "../../i18n/parseTags";

/** Cómo se pinta una etiqueta de los textos traducidos (<b>…</b> → <strong>). */
export interface TagSpec {
  as?: "strong" | "span";
  class?: string;
  attributes?: Record<string, string>;
}

interface Props {
  text: string;
  /** Etiquetas conocidas y cómo pintarlas. Las demás se muestran como texto literal. */
  tags?: Record<string, TagSpec>;
}

const DEFAULT_TAGS: Record<string, TagSpec> = { b: { as: "strong" } };

const { text, tags = DEFAULT_TAGS } = Astro.props;
const parts = parseTags(text, Object.keys(tags));
---

{
  parts.map((part) => {
    const spec = part.tag ? tags[part.tag] : undefined;
    if (!spec) return part.text;
    const Tag = spec.as ?? "span";
    return (
      <Tag class={spec.class} {...spec.attributes}>
        {part.text}
      </Tag>
    );
  })
}
