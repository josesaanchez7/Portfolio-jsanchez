{
  /*
  Eje vertical único (<ol>) de toda la sección Experiencia. Las columnas salen de las variables --rail (ancho del carril del eje)
  y --date (columna de fechas, solo en escritorio) que define el contenedor. Su primer y último hijo son los nodos «Hoy» e
  «Inicio»: el eje nace en el centro del primero (0,9 rem) y acaba en el del último. El carril gris es el fondo y el
  gradiente se «dibuja» según el scroll (--fill, de 0 a 1) a lo largo de todo el eje, sin cortes entre empresas.
  Cada nodo ([data-node]: empresa o puesto) se enciende (data-lit) cuando la franja de lectura llega a él; con eso se
  encienden también sus [data-track]. Los [data-reveal] de un puesto entran una sola vez (data-seen).
  Sin JavaScript o con «reducir movimiento», todo se ve ya dibujado y encendido: el script solo añade data-ready.
*/
}
<ol
  data-timeline
  style="--fill:1"
  class="group relative flex flex-col before:absolute before:top-[0.9rem] before:bottom-[0.9rem] before:left-[calc(var(--rail)/2)] before:w-[3px] before:-translate-x-1/2 before:rounded-full before:bg-border before:content-[''] after:absolute after:top-[0.9rem] after:bottom-[0.9rem] after:left-[calc(var(--rail)/2)] after:w-[3px] after:-translate-x-1/2 after:rounded-full after:bg-linear-to-b after:from-accent after:to-boot-ok after:transition-[clip-path] after:duration-150 after:ease-out after:[clip-path:inset(0_0_calc((1_-_var(--fill))_*_100%)_0)] after:content-[''] nav:before:left-[calc(var(--date)+var(--rail)/2)] nav:after:left-[calc(var(--date)+var(--rail)/2)]"
>
  <slot />
</ol>

<script>
  const READING_LINE = 0.65;

  const lists = [...document.querySelectorAll<HTMLElement>("[data-timeline]")];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reducedMotion) {
    for (const list of lists) {
      const nodes = [...list.querySelectorAll<HTMLElement>("[data-node]")];
      let visible = false;
      let frame = 0;

      // La franja de lectura está a un 65 % de la altura de la ventana: el nodo se enciende al cruzarla.
      const update = () => {
        frame = 0;
        const mark = window.innerHeight * READING_LINE;
        const rect = list.getBoundingClientRect();
        const fill = Math.min(1, Math.max(0, (mark - rect.top) / rect.height));
        list.style.setProperty("--fill", String(fill));
        for (const node of nodes) {
          const lit = node.getBoundingClientRect().top <= mark;
          node.toggleAttribute("data-lit", lit);
          for (const target of node.querySelectorAll("[data-track]")) target.toggleAttribute("data-lit", lit);
          // El contenido entra una sola vez: al volver arriba no se desmonta.
          if (lit) for (const target of node.querySelectorAll("[data-reveal]")) target.setAttribute("data-seen", "");
        }
      };
      const schedule = () => {
        if (visible && !frame) frame = requestAnimationFrame(update);
      };

      list.dataset.ready = "";
      list.style.setProperty("--fill", "0");

      // Solo se escucha el scroll mientras la lista está cerca de la pantalla; el observador avisa con el diseño ya calculado.
      new IntersectionObserver(
        ([entry]) => {
          visible = entry?.isIntersecting ?? false;
          if (visible) update();
        },
        { rootMargin: "25% 0px" },
      ).observe(list);
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
    }
  }
</script>
