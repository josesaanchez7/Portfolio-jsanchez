---
interface Props {
  /** Birrete (estudios) o certificado (certificación). */
  name: "cap" | "certificate";
  class?: string;
}

const { name, class: className } = Astro.props;
---

{/* Siempre decorativo: el significado lo da el texto que lo acompaña. */}
<svg
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {
    name === "cap" ? (
      <>
        <path d="M12 4 2 9l10 5 10-5z" />
        <path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5" />
        <path d="M22 9v6" />
      </>
    ) : (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M7 9h10M7 12.5h5" />
        <circle cx="16" cy="17" r="2.5" />
        <path d="m14.8 19.3-.8 2.7 2-1 2 1-.8-2.7" />
      </>
    )
  }
</svg>
