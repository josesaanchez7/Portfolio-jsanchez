---
import { profile } from "../../data/profile";
import { HERO_ID } from "../../data/sections";
import { getI18n } from "../../i18n";
import { LANGUAGE_CODE } from "../../lib/language";
import { pathForLanguage } from "../../lib/seo";
import Icon from "../ui/Icon.astro";

const { language, t } = getI18n(Astro.currentLocale);

// El selector muestra y activa el idioma al que se cambiaría.
const otherLanguage = language === "es" ? "en" : "es";

// Botones de texto (consola e idioma): filo de 1 px, se iluminan al pasar el ratón y se encogen al pulsar.
const SMALL =
  "inline-flex h-7 cursor-pointer items-center gap-1.5 rounded-sm border border-border-strong bg-transparent px-2 font-[inherit] text-inherit transition-[color,border-color,scale] duration-150 ease-[ease] hover:border-accent hover:text-fg active:scale-[0.97]";
// Iconos (contactos y volver arriba): solo icono; su nombre accesible va en aria-label.
const ICON =
  "grid size-7 place-items-center rounded-sm text-[0.95rem] text-fg-muted transition-[color,background-color,scale] duration-150 ease-[ease] hover:bg-surface hover:text-accent active:scale-[0.94]";

const contacts = [
  { href: `mailto:${profile.email}`, label: profile.email, icon: "envelope", external: false },
  { href: profile.github, label: "GitHub", icon: "github", external: true },
  { href: profile.linkedin, label: "LinkedIn", icon: "linkedin", external: true },
] as const;
---

{
  /*
    Pie de una sola fila: a la izquierda, el ©; a la derecha, los contactos como iconos, la consola, el cambio de
    idioma y volver arriba.
  */
}
<footer aria-label={t.footer.label} class="relative w-full border-t border-border bg-page pb-[env(safe-area-inset-bottom)]">
  <div class="mx-auto flex max-w-site flex-wrap items-center gap-x-5 gap-y-3 px-6 py-4 font-code text-[0.75rem] text-fg-muted max-tablet:px-5">
    <p>{`© ${new Date().getFullYear()} ${profile.name}`}</p>

    <div class="ml-auto flex flex-wrap items-center gap-2">
      <ul class="flex items-center gap-0.5" aria-label={t.hero.profileLinksLabel}>
        {
          contacts.map((contact) => (
            <li>
              <a
                href={contact.href}
                class={ICON}
                aria-label={contact.label}
                {...(contact.external && { target: "_blank", rel: "noopener noreferrer" })}
              >
                <Icon name={contact.icon} />
              </a>
            </li>
          ))
        }
      </ul>
      <span class="h-5 w-px bg-border" aria-hidden="true"></span>
      {/* Consola: también con Ctrl/⌘ K desde cualquier sitio (ver components/console/ConsoleDialog.astro). */}
      <button
        type="button"
        class={SMALL}
        aria-label={t.footer.consoleLabel}
        aria-keyshortcuts="Control+K Meta+K"
        data-console-open
      >
        <span class="text-accent" aria-hidden="true">&gt;_</span>
        {t.footer.console}
      </button>
      {/* Cambiar de idioma es ir a la otra URL ("/" ↔ "/en/"); el script conserva el ancla y el scroll y recuerda la elección. */}
      <a
        href={pathForLanguage(otherLanguage)}
        data-language-switch={otherLanguage}
        hreflang={otherLanguage}
        lang={otherLanguage}
        class={SMALL}
        aria-label={t.header.switchLanguage[otherLanguage]}
      >
        {LANGUAGE_CODE[otherLanguage]}
      </a>
      <a href={`#${HERO_ID}`} class={ICON} aria-label={t.footer.backToTop}>
        <Icon name="arrowRight" class="-rotate-90" />
      </a>
    </div>
  </div>
</footer>

<script>
  import { parseLanguage, storeLanguage } from "../../lib/language";

  // --- Cambio de idioma -------------------------------------------------------------------------
  // Es un enlace normal (funciona sin JavaScript); antes de navegar se recuerda la elección, se
  // conservan la búsqueda y el ancla, y se mantiene el scroll (la pantalla de carga no se repite: solo sale una vez por sesión).
  const SCROLL_KEY = "scroll-restore";
  // Todos los enlaces de idioma de la página (el del pie y los accesos de EntryHint/hero).
  for (const languageSwitch of document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]")) {
    languageSwitch.addEventListener("click", () => {
      const next = parseLanguage(languageSwitch.dataset.languageSwitch);
      if (!next) return;

      storeLanguage(next);
      languageSwitch.href = languageSwitch.pathname + window.location.search + window.location.hash;
      try {
        sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
      } catch {
        // Sin sessionStorage se empieza arriba.
      }
    });
  }

  try {
    const saved = Number(sessionStorage.getItem(SCROLL_KEY));
    sessionStorage.removeItem(SCROLL_KEY);
    if (saved > 0) {
      window.addEventListener("load", () => window.scrollTo({ top: saved, behavior: "instant" }), { once: true });
    }
  } catch {
    // Sin sessionStorage se empieza arriba.
  }
</script>
