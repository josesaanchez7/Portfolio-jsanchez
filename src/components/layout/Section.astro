---
import { getSection, type SectionId } from "../../data/sections";
import { getI18n } from "../../i18n";
import { DEBUG_SECTION } from "../../lib/debugSection";

interface Props {
  id: SectionId;
}

const { id } = Astro.props;
const { localize } = getI18n(Astro.currentLocale);
const { title, number } = getSection(id);
const headingId = `${id}-title`;
---

{/* Sección con encabezado numerado. Título y número salen de `data/sections.ts`. */}
<section
  id={id}
  data-section={id}
  aria-labelledby={headingId}
  class={`w-full scroll-mt-(--header-height) border-t border-border px-6 py-24 max-tablet:px-5 max-tablet:py-16 ${DEBUG_SECTION}`}
>
  <div class="mx-auto flex w-full max-w-site flex-col gap-10 max-tablet:gap-8">
    <header class="flex items-baseline gap-4">
      <span class="font-code text-[0.9rem] text-accent" aria-hidden="true">
        {number}
      </span>
      <h2 id={headingId} class="text-[clamp(1.75rem,4vw,2.5rem)]">
        {localize(title)}
      </h2>
    </header>
    <slot />
  </div>
</section>
