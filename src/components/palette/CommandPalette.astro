---
import { cvUrl } from "../../data/cv";
import { profile } from "../../data/profile";
import { HERO_ID, SECTIONS } from "../../data/sections";
import { getI18n } from "../../i18n";
import { LANGUAGE_CODE } from "../../lib/language";
import { normalizeSearch } from "../../scripts/palette";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../ui/icons";

const { language, t, localize } = getI18n(Astro.currentLocale);
const otherLanguage = language === "es" ? "en" : "es";

type GroupId = "go" | "actions" | "links";

interface Command {
  id: string;
  group: GroupId;
  label: string;
  /** Palabras extra por las que también se encuentra. */
  keywords?: string;
  icon?: IconName;
  /** Texto corto a la derecha (p. ej. el código del idioma). */
  badge?: string;
  /** Atributos data-* con los que el script sabe qué hacer. */
  data: Record<string, string>;
}

// Todos los comandos salen ya en el HTML: el script solo filtra, elige y ejecuta.
const commands: Command[] = [
  { id: "go-home", group: "go", label: t.palette.home, icon: "arrowRight", data: { command: "goto", target: `#${HERO_ID}` } },
  ...SECTIONS.map(
    ({ id, navLabel }): Command => ({
      id: `go-${id}`,
      group: "go",
      label: localize(navLabel),
      icon: "arrowRight",
      data: { command: "goto", target: `#${id}` },
    }),
  ),
  {
    id: "theme",
    group: "actions",
    label: t.header.themeToLight,
    keywords: t.palette.keywords.theme,
    data: {
      command: "theme",
      "label-to-light": t.header.themeToLight,
      "label-to-dark": t.header.themeToDark,
    },
  },
  {
    id: "language",
    group: "actions",
    label: t.header.switchLanguage[otherLanguage],
    keywords: t.palette.keywords.language,
    badge: LANGUAGE_CODE[otherLanguage],
    data: { command: "language" },
  },
  {
    id: "copy-email",
    group: "actions",
    label: t.contact.copyLabel,
    keywords: t.palette.keywords.email,
    icon: "copy",
    data: {
      command: "copy-email",
      email: profile.email,
      "message-copied": t.contact.copied,
      "message-error": t.contact.copyError,
    },
  },
  {
    id: "cv",
    group: "actions",
    label: t.hero.downloadCv,
    keywords: t.palette.keywords.cv,
    icon: "download",
    data: { command: "cv", href: cvUrl },
  },
  {
    id: "console",
    group: "actions",
    label: t.palette.openConsole,
    keywords: t.palette.keywords.console,
    badge: ">_",
    data: { command: "console" },
  },
  {
    id: "debug",
    group: "actions",
    label: t.palette.toggleDebug,
    keywords: t.palette.keywords.debug,
    badge: "debug",
    data: { command: "debug" },
  },
  {
    id: "github",
    group: "links",
    label: "GitHub",
    keywords: t.palette.keywords.links,
    icon: "github",
    data: { command: "open", href: profile.github },
  },
  {
    id: "linkedin",
    group: "links",
    label: "LinkedIn",
    keywords: t.palette.keywords.links,
    icon: "linkedin",
    data: { command: "open", href: profile.linkedin },
  },
];

const groups = (["go", "actions", "links"] as const).map((id) => ({
  id,
  label: t.palette.groups[id],
  items: commands.filter((command) => command.group === id),
}));

const KBD =
  "rounded-[6px] border border-border-strong px-1.5 py-0.5 font-code text-[0.72rem] leading-none text-fg-muted";
---

{/*
  Paleta de comandos (Ctrl/⌘ + K): buscador para ir a una sección o ejecutar una acción. Patrón combobox +
  listbox: el foco se queda en el campo y `aria-activedescendant` apunta a la opción elegida. El HTML ya lleva todas las
  opciones; el <script> las filtra con src/scripts/palette.ts y ejecuta la elegida.
*/}
<dialog
  data-palette
  aria-label={t.palette.title}
  class="mx-auto mt-[12dvh] mb-auto w-[min(560px,calc(100%-2rem))] overflow-hidden rounded-lg border border-border bg-surface p-0 text-fg shadow-[0_24px_80px_rgba(0,0,0,0.45)] backdrop:bg-[rgba(8,10,16,0.6)] backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-border px-4">
    <Icon name="search" class="shrink-0 text-[1.05rem] text-fg-muted" />
    <input
      data-palette-input
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-activedescendant=""
      aria-label={t.palette.inputLabel}
      placeholder={t.palette.placeholder}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      class="min-w-0 flex-1 border-0 bg-transparent py-4 text-[1rem] text-fg outline-none placeholder:text-fg-muted"
    />
    <kbd class={KBD} aria-hidden="true">esc</kbd>
  </div>

  <div
    id="palette-list"
    role="listbox"
    aria-label={t.palette.title}
    data-palette-list
    class="max-h-[min(420px,55dvh)] overflow-y-auto overscroll-contain p-2"
  >
    {
      groups.map((group) => (
        <div role="group" aria-labelledby={`palette-group-${group.id}`} data-palette-group>
          <div
            id={`palette-group-${group.id}`}
            role="presentation"
            class="px-3 pt-2 pb-1 font-code text-[0.72rem] tracking-[0.04em] text-fg-muted uppercase"
          >
            {group.label}
          </div>
          {group.items.map((command) => (
            <div
              id={`palette-option-${command.id}`}
              role="option"
              aria-selected="false"
              data-search={normalizeSearch(`${command.label} ${command.keywords ?? ""}`)}
              {...Object.fromEntries(Object.entries(command.data).map(([key, value]) => [`data-${key}`, value]))}
              class="flex cursor-pointer items-center gap-3 rounded-sm px-3 py-2.5 text-fg-muted aria-selected:bg-accent-soft aria-selected:text-fg"
            >
              {command.id === "theme" ? (
                <span class="grid w-4 shrink-0 place-items-center text-[1rem]">
                  <Icon name="moon" class="in-data-[theme=light]:hidden" />
                  <Icon name="sun" class="hidden in-data-[theme=light]:block" />
                </span>
              ) : command.icon ? (
                <span class="grid w-4 shrink-0 place-items-center text-[1rem]">
                  <Icon name={command.icon} />
                </span>
              ) : (
                <span class="w-4 shrink-0" aria-hidden="true" />
              )}
              <span class="min-w-0 flex-1 truncate" data-palette-label>
                {command.label}
              </span>
              {command.badge && (
                <span class={KBD} aria-hidden="true">
                  {command.badge}
                </span>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <p
    data-palette-empty
    hidden
    role="status"
    class="px-4 py-6 text-center text-[0.95rem] text-fg-muted"
  >
    {t.palette.empty}
  </p>

  <div
    class="flex items-center gap-4 border-t border-border px-4 py-2.5 font-code text-[0.72rem] text-fg-muted max-phone:hidden"
    aria-hidden="true"
  >
    <span><kbd class={KBD}>↑↓</kbd> {t.palette.hints.navigate}</span>
    <span><kbd class={KBD}>↵</kbd> {t.palette.hints.select}</span>
    <span><kbd class={KBD}>esc</kbd> {t.palette.hints.close}</span>
  </div>
</dialog>

<script>
  import { toggleDebug } from "../../scripts/debug";
  import { matchesQuery, wrapIndex } from "../../scripts/palette";
  import { showToast } from "../../scripts/toast";

  const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-palette-input]");
  const emptyState = dialog?.querySelector<HTMLElement>("[data-palette-empty]");

  if (dialog && input && emptyState) {
    const options = [...dialog.querySelectorAll<HTMLElement>('[role="option"]')];
    const groups = [...dialog.querySelectorAll<HTMLElement>("[data-palette-group]")];
    const html = document.documentElement;
    let visible: HTMLElement[] = options;
    let active = -1;
    let returnFocus: HTMLElement | null = null;
    let pending: (() => void) | null = null;

    // ⌘K en Mac, Ctrl K en el resto: el HTML trae «Ctrl K» y aquí se adapta.
    const isMac = /mac|iphone|ipad/i.test(navigator.platform);
    if (isMac) {
      for (const hint of document.querySelectorAll("[data-palette-kbd]")) hint.textContent = "⌘K";
    }

    // --- Selección y filtrado ------------------------------------------------------------------
    const setActive = (index: number, scroll = false) => {
      active = index;
      options.forEach((option) => option.setAttribute("aria-selected", "false"));
      const current = visible[index];
      current?.setAttribute("aria-selected", "true");
      input.setAttribute("aria-activedescendant", current?.id ?? "");
      if (scroll) current?.scrollIntoView({ block: "nearest" });
    };

    const filter = () => {
      visible = options.filter((option) => matchesQuery(option.dataset.search ?? "", input.value));
      for (const option of options) option.hidden = !visible.includes(option);
      for (const group of groups) {
        group.hidden = !group.querySelector('[role="option"]:not([hidden])');
      }
      emptyState.hidden = visible.length > 0;
      setActive(visible.length > 0 ? 0 : -1);
    };

    // El nombre del comando de tema depende del tema actual.
    const syncThemeLabel = () => {
      const option = dialog.querySelector<HTMLElement>('[data-command="theme"]');
      const label = option?.querySelector("[data-palette-label]");
      if (!option || !label) return;
      const toLight = document.documentElement.dataset.theme !== "light";
      label.textContent = (toLight ? option.dataset.labelToLight : option.dataset.labelToDark) ?? "";
    };

    // --- Comandos -------------------------------------------------------------------------------
    const click = (selector: string) => document.querySelector<HTMLElement>(selector)?.click();

    const commands: Record<string, (option: HTMLElement) => void> = {
      goto: ({ dataset }) => {
        const hash = dataset.target ?? "";
        document.querySelector(hash)?.scrollIntoView();
        window.history.pushState(null, "", hash);
      },
      // Se reutilizan los controles que ya existen: cada uno guarda su estado y sus etiquetas.
      theme: () => click("[data-theme-toggle]"),
      language: () => click("[data-language-switch]"),
      console: () => click("[data-console-open]"),
      debug: () => toggleDebug(),
      "copy-email": async ({ dataset }) => {
        try {
          await navigator.clipboard.writeText(dataset.email ?? "");
          showToast(dataset.messageCopied ?? "");
        } catch {
          // También cubre contextos sin Clipboard API (p. ej. http sin TLS).
          showToast(dataset.messageError ?? "", "error");
        }
      },
      cv: ({ dataset }) => {
        const link = document.createElement("a");
        link.href = dataset.href ?? "";
        link.download = "Jose_Sanchez_CV.pdf";
        link.click();
      },
      open: ({ dataset }) => {
        window.open(dataset.href, "_blank", "noopener,noreferrer");
      },
    };

    // La acción se ejecuta cuando la paleta ya se cerró y devolvió el foco (evento `close`), para que lo que
    // abra después (p. ej. la consola) recuerde el elemento correcto y no pierda el foco.
    const run = (option: HTMLElement) => {
      const action = commands[option.dataset.command ?? ""];
      if (!action) return;
      pending = () => void action(option);
      dialog.close();
    };

    // --- Abrir y cerrar -------------------------------------------------------------------------
    // Ni durante la pantalla de carga (<html data-boot>) ni encima de otro diálogo (consola, caso de estudio).
    const canOpen = () => !("boot" in html.dataset) && !document.querySelector("dialog[open]");

    const open = () => {
      if (dialog.open || !canOpen()) return;
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      input.value = "";
      syncThemeLabel();
      filter();
      // Mientras está abierta, la página de detrás no hace scroll (ver global.css).
      html.toggleAttribute("data-palette-active", true);
      dialog.showModal();
      input.focus();
    };

    dialog.addEventListener("close", () => {
      html.removeAttribute("data-palette-active");
      // Si otro diálogo ya tomó el foco, no se lo quitamos.
      if (!document.querySelector("dialog[open]")) returnFocus?.focus();
      returnFocus = null;
      const action = pending;
      pending = null;
      action?.();
    });
    dialog.addEventListener("click", (event) => {
      // Clic en el fondo (fuera de la ventana) cierra la paleta.
      if (event.target === dialog) dialog.close();
    });

    for (const trigger of document.querySelectorAll<HTMLElement>("[data-palette-open]")) {
      trigger.addEventListener("click", open);
    }

    // Ctrl/⌘ + K abre y cierra la paleta desde cualquier parte.
    document.addEventListener("keydown", (event) => {
      if (!(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey || event.key.toLowerCase() !== "k") return;
      if ("boot" in html.dataset) return;
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    });

    // --- Teclado y ratón dentro de la paleta ------------------------------------------------------
    input.addEventListener("input", filter);

    input.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
        case "ArrowUp":
          event.preventDefault();
          setActive(wrapIndex(active, event.key === "ArrowDown" ? 1 : -1, visible.length), true);
          break;
        case "Home":
        case "End":
          // En el campo de texto, Inicio/Fin mueven el cursor: solo se interceptan con Ctrl/⌘.
          if (!(event.ctrlKey || event.metaKey)) break;
          event.preventDefault();
          setActive(event.key === "Home" ? 0 : visible.length - 1, true);
          break;
        case "Enter": {
          event.preventDefault();
          const option = visible[active];
          if (option) run(option);
          break;
        }
      }
    });

    for (const option of options) {
      option.addEventListener("pointermove", () => {
        const index = visible.indexOf(option);
        if (index !== active) setActive(index);
      });
      option.addEventListener("click", () => run(option));
    }
  }
</script>
