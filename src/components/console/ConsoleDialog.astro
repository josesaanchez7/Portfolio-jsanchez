---
import { messages } from "../../i18n/messages";

// La consola es siempre en inglés, en las dos versiones de la web: una shell no se traduce.
const t = messages.en;

const WINDOW_TITLE = "jose@portfolio — zsh";

// Siempre oscura, como la pantalla de carga: usa sus colores (--color-boot-*), no los del tema.
const DIALOG =
  "scheme-dark m-auto h-[min(460px,calc(100dvh-2rem))] w-[min(720px,calc(100%-2rem))] overflow-hidden rounded-lg border border-boot-dot bg-boot-bg p-0 font-boot text-[14px] leading-[1.6] text-boot-text shadow-[0_24px_80px_rgba(0,0,0,0.55)] backdrop:bg-[rgba(0,0,0,0.7)]";
---

{/*
  Consola interactiva que simula una terminal. Se mantiene en la página (cerrada) para conservar
  la transcripción y el historial de comandos mientras esté abierta. El comportamiento está en el
  <script> de abajo; los comandos, en src/scripts/console/commands.ts.
*/}
<dialog lang="en" aria-label={t.console.title} class={DIALOG} data-console>
  <div class="flex h-full flex-col">
    <header
      class="flex shrink-0 items-center justify-between border-b border-boot-dot py-[0.35rem] pr-2 pl-4 text-[0.9em] text-boot-dim"
    >
      <span>{WINDOW_TITLE}</span>
      <button
        type="button"
        aria-label={t.console.close}
        aria-keyshortcuts="Escape"
        data-console-close
        class="grid h-7 w-7 cursor-pointer place-items-center rounded-sm text-[1.5em] leading-none text-boot-dim transition-colors duration-200 hover:text-boot-text focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-boot-prompt"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      data-console-log
      class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-3 [overflow-wrap:anywhere] whitespace-pre-wrap"
    >
    </div>

    <form
      data-console-form
      class="flex shrink-0 items-center gap-2 border-t border-boot-dot px-4 py-2"
    >
      <span class="whitespace-nowrap text-boot-prompt" aria-hidden="true" data-console-cwd>~ $</span>
      <input
        data-console-input
        aria-label={t.console.inputLabel}
        placeholder={t.console.placeholder}
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="send"
        class="min-w-0 flex-1 border-0 bg-transparent p-0 text-inherit outline-none placeholder:text-boot-dim [@media(pointer:coarse)]:text-[16px]"
      />
    </form>
  </div>
</dialog>

<script>
  import { cvUrl } from "../../data/cv";
  import { copyText } from "../../scripts/clipboard";
  import { profile } from "../../data/profile";
  import { projects } from "../../data/projects";
  import { messages } from "../../i18n/messages";
  import { completeInput, welcomeLine } from "../../scripts/console/commands";
  import type {
    CommandContext,
    ConsoleEffect,
    ConsoleLine,
    ConsoleTone,
  } from "../../scripts/console/consoleTypes";
  import { createConsoleSession } from "../../scripts/console/session";

  const TONE_CLASS: Record<ConsoleTone, string> = {
    ok: "text-boot-ok",
    dim: "text-boot-dim",
    warn: "text-boot-warn",
    info: "text-boot-prompt",
  };

  const dialog = document.querySelector<HTMLDialogElement>("[data-console]");
  const log = dialog?.querySelector<HTMLElement>("[data-console-log]");
  const form = dialog?.querySelector<HTMLFormElement>("[data-console-form]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-console-input]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-console-close]");
  const cwdLabel = dialog?.querySelector<HTMLElement>("[data-console-cwd]");

  if (dialog && log && form && input && closeButton) {
    // Siempre en inglés (comandos, ayuda, carpetas y mensajes), sea cual sea el idioma de la página.
    const language = "en" as const;

    const getContext = (): CommandContext => ({
      t: messages[language],
      language,
      localize: (text) => text[language],
      profile,
      projects,
    });

    /** Una línea de resultados. Todo el texto se pinta como texto plano: nunca se interpreta como HTML. */
    const renderLine = (line: ConsoleLine): HTMLDivElement => {
      const row = document.createElement("div");
      row.className = "min-h-[1.6em]";

      for (const segment of line) {
        const tone = segment.tone ? TONE_CLASS[segment.tone] : undefined;
        if (segment.href) {
          const link = document.createElement("a");
          link.href = segment.href;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.className = `underline underline-offset-2 hover:text-boot-text ${tone ?? TONE_CLASS.info}`;
          link.textContent = segment.text;
          row.append(link);
        } else {
          const span = document.createElement("span");
          if (tone) span.className = tone;
          span.textContent = segment.text;
          row.append(span);
        }
      }
      return row;
    };

    const append = (lines: readonly ConsoleLine[]) => {
      log.append(...lines.map(renderLine));
      // Los resultados nuevos bajan solos. Con la consola cerrada no se mide nada: leer scrollHeight
      // obligaría al navegador a recalcular todo el diseño de la página al cargar.
      if (dialog.open) log.scrollTop = log.scrollHeight;
    };

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Lleva a una sección: el foco pasa a ella (no vuelve al botón que abrió la consola, que podría estar lejos y
    // devolver el scroll) y el scroll se hace con la página ya desbloqueada.
    const goToSection = (sectionId: string) => {
      const section = document.getElementById(sectionId);
      if (!section) return;
      returnFocus = null;
      document.documentElement.removeAttribute("data-console-active");
      if (!section.hasAttribute("tabindex")) section.setAttribute("tabindex", "-1");
      section.focus({ preventScroll: true });
      section.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    };

    const downloadCv = () => {
      const link = Object.assign(document.createElement("a"), { href: cvUrl, download: "Jose_Sanchez_CV.pdf" });
      document.body.append(link);
      link.click();
      link.remove();
    };

    // Se confirma con una línea nueva; el <textarea> de respaldo va dentro del diálogo (el resto de la página está inerte).
    const copy = (value: string) => {
      const { t } = getContext();
      void copyText(value, dialog).then((ok) =>
        append([[{ text: ok ? t.console.copied(value) : t.console.copyFailed(value), tone: ok ? "ok" : "warn" }]]),
      );
    };

    const handleEffect = (effect: ConsoleEffect) => {
      switch (effect.type) {
        case "close":
          dialog.close();
          break;
        case "scrollTo":
          goToSection(effect.sectionId);
          break;
        case "openCv":
          window.open(cvUrl, "_blank", "noopener,noreferrer");
          break;
        case "downloadCv":
          downloadCv();
          break;
        case "openUrl":
          window.open(effect.url, "_blank", "noopener,noreferrer");
          break;
        case "copy":
          copy(effect.text);
          break;
      }
    };

    const session = createConsoleSession({
      getContext,
      onEffect: handleEffect,
      onAppend: append,
      onClear: () => log.replaceChildren(),
      // El prompt de la línea de comandos muestra la carpeta actual, como en una shell.
      onCwdChange: (cwd) => {
        if (cwdLabel) cwdLabel.textContent = `${cwd} $`;
      },
    });
    append([welcomeLine(getContext())]);

    // --- Abrir y cerrar -------------------------------------------------------------------
    let returnFocus: HTMLElement | null = null;

    // La consola no se puede abrir mientras se muestra la pantalla de carga (<html data-boot>).
    const isBooting = () => "boot" in document.documentElement.dataset;

    // La primera vez que se abre, `help` se escribe solo (letra a letra) y se ejecuta, para que se vean los comandos
    // sin tener que saber cuál teclear. Con «reducir movimiento» se ejecuta directamente. Si se cierra a medias, se
    // vuelve a intentar en la siguiente apertura.
    const AUTO_COMMAND = "help";
    const AUTO_CHAR_MS = 70;
    let autoHelpDone = false;
    let autoTimer: number | undefined;

    const autoHelp = () => {
      if (autoHelpDone) return;
      autoHelpDone = true;
      if (reducedMotion) {
        session.submit(AUTO_COMMAND);
        return;
      }
      input.readOnly = true;
      let typed = 0;
      const step = () => {
        if (!dialog.open) {
          input.value = "";
          input.readOnly = false;
          autoHelpDone = false;
          return;
        }
        typed += 1;
        input.value = AUTO_COMMAND.slice(0, typed);
        if (typed < AUTO_COMMAND.length) {
          autoTimer = window.setTimeout(step, AUTO_CHAR_MS);
          return;
        }
        autoTimer = window.setTimeout(() => {
          input.value = "";
          input.readOnly = false;
          session.submit(AUTO_COMMAND);
        }, AUTO_CHAR_MS * 2);
      };
      window.clearTimeout(autoTimer);
      autoTimer = window.setTimeout(step, 200);
    };

    const open = () => {
      if (dialog.open || isBooting()) return;
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      // Mientras está abierta, la página de detrás no hace scroll (ver global.css).
      document.documentElement.toggleAttribute("data-console-active", true);
      dialog.showModal();
      log.scrollTop = log.scrollHeight;
      input.focus();
      autoHelp();
    };

    // Cualquier cierre (Esc, ×, clic fuera, exit…) acaba aquí: devuelve el foco a quien abrió.
    dialog.addEventListener("close", () => {
      document.documentElement.removeAttribute("data-console-active");
      returnFocus?.focus();
      returnFocus = null;
    });
    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      // Clic en el fondo (fuera de la ventana) cierra la consola.
      if (event.target === dialog) dialog.close();
    });
    for (const trigger of document.querySelectorAll<HTMLElement>("[data-console-open]")) {
      trigger.addEventListener("click", open);
    }

    // --- Atajos globales -------------------------------------------------------------------------
    // Ctrl/⌘ + K abre la consola (y la cierra si ya está abierta), también al escribir. La tecla ` la abre solo si no se
    // está escribiendo. ⌘K en Mac, Ctrl K en el resto: el HTML de la cabecera trae «Ctrl K» y aquí se adapta.
    if (/mac|iphone|ipad/i.test(navigator.platform)) {
      for (const hint of document.querySelectorAll("[data-console-kbd]")) hint.textContent = "⌘K";
    }
    const isShortcutK = (event: KeyboardEvent): boolean =>
      (event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey && event.key.toLowerCase() === "k";

    const isTypingTarget = (target: EventTarget | null): boolean =>
      target instanceof HTMLElement &&
      (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName));

    // La tecla ` es una tecla muerta en el teclado español (key "Dead", en la tecla a la derecha de la P),
    // así que se reconoce también por su posición física cuando no se pulsa con Mayús (Mayús+tecla = ^).
    const isGraveKey = (event: KeyboardEvent): boolean =>
      event.key === "`" || (event.key === "Dead" && event.code === "BracketLeft" && !event.shiftKey);

    document.addEventListener("keydown", (event) => {
      if (isBooting() || event.repeat) return;

      if (isShortcutK(event)) {
        // Evita el atajo del navegador (en algunos, Ctrl K enfoca la búsqueda).
        event.preventDefault();
        if (dialog.open) dialog.close();
        // Ni encima de otro diálogo (un caso de estudio o la imagen ampliada).
        else if (!document.querySelector("dialog[open]")) open();
        return;
      }

      if (
        isGraveKey(event) &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey &&
        !isTypingTarget(event.target) &&
        // Ni encima de otro diálogo (un caso de estudio o la imagen ampliada).
        !document.querySelector("dialog[open]")
      ) {
        event.preventDefault();
        open();
      }
    });

    // --- Línea de comandos ----------------------------------------------------------------
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      session.submit(input.value);
      input.value = "";
    });

    input.addEventListener("keydown", (event) => {
      // Tab autocompleta comandos, carpetas y archivos; con varias opciones las lista debajo, como bash. Con la línea
      // vacía, Tab sigue moviendo el foco (no se atrapa al usuario de teclado).
      if (event.key === "Tab" && !event.shiftKey && input.value.trim() !== "") {
        event.preventDefault();
        const { value, options } = completeInput(input.value, language);
        input.value = value;
        if (options.length > 1) append([[{ text: options.join("  "), tone: "dim" }]]);
        return;
      }
      // Ctrl+L limpia la consola, como en una terminal.
      if (event.key.toLowerCase() === "l" && event.ctrlKey && !event.altKey && !event.shiftKey && !event.metaKey) {
        event.preventDefault();
        log.replaceChildren();
        return;
      }
      if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
      event.preventDefault();
      const recalled = event.key === "ArrowUp" ? session.previous(input.value) : session.next();
      if (recalled !== null) input.value = recalled;
    });

    log.addEventListener("click", () => {
      // Un clic en los resultados enfoca la línea de comandos, salvo que se esté seleccionando texto.
      if (!window.getSelection()?.toString()) input.focus();
    });
  }
</script>
