---
import { getI18n } from "../../i18n";
import type { UpcomingCertification } from "../../types/content";

interface Props {
  upcoming: UpcomingCertification;
}

const { upcoming } = Astro.props;
const { t, localize } = getI18n(Astro.currentLocale);
---

{/* Hueco para crecer: una certificación en el horizonte, con el mismo tamaño que las insignias. */}
<div class="flex items-center gap-3 rounded-md border-2 border-dashed border-border-strong px-4 py-2">
  <div class="flex min-w-0 flex-col">
    <p class="font-code text-[0.8125rem] text-accent">{t.experience.nextCertification}</p>
    <h4 class="text-[0.95rem] leading-tight">{localize(upcoming.title)}</h4>
  </div>
  {
    upcoming.status && (
      <span class="rounded-full bg-accent-soft px-[0.6rem] py-[0.1rem] font-code text-[0.8125rem] text-accent">
        {localize(upcoming.status)}
      </span>
    )
  }
</div>
