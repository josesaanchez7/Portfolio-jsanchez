---
import { Image } from "astro:assets";
import perfil from "../../assets/img/hero.webp";
import { cvUrl } from "../../data/cv";
import { profile } from "../../data/profile";
import { HERO_ID } from "../../data/sections";
import { getI18n } from "../../i18n";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import RichText, { type TagSpec } from "../ui/RichText.astro";

const { t, localize } = getI18n(Astro.currentLocale);
const job = localize(profile.currentJob);

// La frase clave va en el azul de acento, en un solo color (sin degradado ni destello).
const TITLE_TAGS: Record<string, TagSpec> = {
  h: { as: "span", class: "text-accent" },
};

// Entrada escalonada (ver `animate-rise` en global.css): cada elemento pone su posición en --i.
const RISE = "animate-rise [animation-delay:calc(var(--i)*70ms)]";

// Perfiles como botones cuadrados de solo icono, a la altura de los botones de acción (su nombre va en aria-label).
const ICON_LINK =
  "grid aspect-square place-items-center rounded-sm border border-border-strong text-[1.1rem] text-fg-muted transition-[color,border-color,scale] duration-150 ease-[ease] hover:border-accent hover:text-accent active:scale-[0.97]";
const links = [
  { href: profile.github, label: "GitHub", icon: "github" },
  { href: profile.linkedin, label: "LinkedIn", icon: "linkedin" },
] as const;

---

<section
  id={HERO_ID}
  data-section={HERO_ID}
  aria-labelledby="hero-title"
  class="hero-screen relative flex flex-col justify-center scroll-mt-(--header-height) px-6 pt-[calc(var(--header-height)+1.5rem)] pb-20"
>
  <div
    class="mx-auto grid w-full max-w-site grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] items-center gap-[clamp(2rem,6vw,5rem)] max-nav:grid-cols-1"
  >
    <div class="flex flex-col items-start gap-6">
      <p class={`${RISE} flex flex-wrap items-baseline gap-x-3 gap-y-1`} style="--i:0">
        <span class="text-[clamp(1.15rem,2.2vw,1.35rem)] font-semibold tracking-[-0.01em] text-fg">{profile.name}</span>
        <span class="font-code text-[0.85rem] text-accent">{t.hero.eyebrowRole(job, profile.employer)}</span>
      </p>

      <h1
        id="hero-title"
        class={`${RISE} text-[clamp(2.2rem,5.1vw,3.8rem)] leading-[1.06] tracking-[-0.035em] text-balance`}
        style="--i:1"
      >
        <RichText text={t.hero.title} tags={TITLE_TAGS} />
      </h1>

      <p
        class={`${RISE} max-w-[56ch] text-[clamp(1rem,2vw,1.15rem)] text-fg-muted [&_strong]:font-semibold [&_strong]:text-fg`}
        style="--i:2"
      >
        <RichText
          text={t.hero.lead({ role: localize(profile.role), job, employer: profile.employer })}
        />
      </p>

      <div class={`${RISE} mt-2 flex flex-wrap items-stretch gap-3`} style="--i:3">
        <Button href="#Proyectos" icon="arrowRight">{t.hero.viewProjects}</Button>
        <Button href={cvUrl} download="Jose_Sanchez_CV.pdf" variant="secondary" icon="download">
          {t.hero.downloadCv}
        </Button>
        <ul class="flex items-stretch gap-3" aria-label={t.hero.profileLinksLabel}>
          {
            links.map(({ href, label, icon }) => (
              <li class="flex">
                <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class={ICON_LINK}>
                  <Icon name={icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/*
      Retrato con un filo de 1 px. Todo quieto: sin flotación, haz de luz ni inclinación.
    */}
    <div class={`${RISE} relative w-[min(100%,300px)] justify-self-end max-nav:order-first max-nav:w-[112px] max-nav:justify-self-start`} style="--i:2">
      <figure class="relative m-0 overflow-hidden rounded-lg border border-border">
        <Image
          src={perfil}
          alt={t.hero.portraitAlt(profile.name)}
          width={340}
          height={340}
          widths={[340, 680]}
          sizes="(max-width: 820px) 112px, 300px"
          loading="eager"
          class="aspect-square w-full object-cover"
        />
      </figure>
    </div>
  </div>

  {/* Indicador de que hay más abajo: el hero ocupa toda la pantalla y la siguiente sección empieza justo bajo el borde. Decorativo. */}
  <div
    class={`${RISE} pointer-events-none absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 font-code text-[0.75rem] text-fg-muted max-nav:hidden [@media(max-height:620px)]:hidden`}
    style="--i:5"
    aria-hidden="true"
  >
    <span>scroll</span>
    <span class="h-8 w-px bg-linear-to-b from-border-strong to-transparent"></span>
  </div>
</section>
