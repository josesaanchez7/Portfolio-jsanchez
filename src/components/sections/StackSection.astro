---
import { stack } from "../../data/stack";
import { getI18n } from "../../i18n";
import Section from "../layout/Section.astro";

const { localize } = getI18n(Astro.currentLocale);
---

<Section id="Stack">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-6">
    {
      stack.map((category) => (
        <div class="flex flex-col gap-4 rounded-md border border-border bg-surface p-6">
          <h3 class="font-code text-[0.8rem] font-medium tracking-[0.04em] text-accent uppercase">
            {localize(category.label)}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {category.items.map((item) => (
              <li class="rounded-sm border border-border-strong px-3 py-[0.3rem] text-[0.92rem]">
                {localize(item)}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
