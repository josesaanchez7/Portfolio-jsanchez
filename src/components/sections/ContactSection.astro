---
import { profile } from "../../data/profile";
import { statusBar } from "../../data/statusBar";
import { getI18n } from "../../i18n";
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

const { t } = getI18n(Astro.currentLocale);
---

<Section id="Contacto">
  <div
    class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] items-start gap-[clamp(2rem,5vw,4rem)] max-nav:grid-cols-1"
    data-contact
  >
    <div class="flex flex-col items-start gap-6">
      <p class="max-w-[44ch] text-[1.1rem] text-fg-muted">{t.contact.intro}</p>
      {
        statusBar.available && (
          <p class="inline-flex items-center gap-3 rounded-full border border-border bg-surface px-4 py-2 text-[0.92rem] font-medium">
            {/* Punto verde que late; con «reducir movimiento» queda fijo. */}
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-boot-ok opacity-60" />
              <span class="relative inline-flex size-2.5 rounded-full bg-boot-ok" />
            </span>
            {t.contact.available}
          </p>
        )
      }
    </div>

    <div class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-6">
      <div class="flex items-stretch overflow-hidden rounded-sm border border-border-strong bg-page">
        <a
          href={`mailto:${profile.email}`}
          class="min-w-0 flex-1 px-4 py-[0.8rem] font-code text-[0.92rem] [overflow-wrap:anywhere] text-fg hover:text-accent"
        >
          {profile.email}
        </a>
        <button
          type="button"
          class="group grid w-12 cursor-pointer place-items-center border-l border-border-strong bg-transparent text-[1rem] text-fg-muted transition-[color,background-color] duration-200 ease-[ease] hover:bg-surface-hover hover:text-accent"
          aria-label={t.contact.copyLabel}
          data-copy-email={profile.email}
          data-copied-message={t.contact.copied}
          data-error-message={t.contact.copyError}
        >
          <Icon name="copy" class="group-data-copied:hidden" />
          <Icon name="check" class="hidden group-data-copied:block" />
        </button>
      </div>

      <div class="flex flex-wrap gap-3">
        <Button href={`mailto:${profile.email}`} icon="envelope">{t.contact.sendEmail}</Button>
        <Button href={profile.linkedin} external variant="secondary" icon="linkedin">
          LinkedIn
        </Button>
        <Button href={profile.github} external variant="secondary" icon="github">GitHub</Button>
      </div>
    </div>
  </div>
</Section>

<script>
  import { showToast } from "../../scripts/toast";

  const ICON_RESET_MS = 2500;

  const button = document.querySelector<HTMLButtonElement>("[data-contact] [data-copy-email]");

  if (button) {
    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
        copied = true;
      } catch {
        // También cubre contextos sin Clipboard API (p. ej. http sin TLS).
      }

      // El aviso (región role="status") lo anuncia a los lectores de pantalla; el botón muestra un ✓ un rato.
      showToast((copied ? button.dataset.copiedMessage : button.dataset.errorMessage) ?? "", copied ? "ok" : "error");
      button.toggleAttribute("data-copied", copied);
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => button.removeAttribute("data-copied"), ICON_RESET_MS);
    });
  }
</script>
