---
import { getI18n } from "../../i18n";
import { formatMonthYear } from "../../lib/format";
import type { ExperienceItem } from "../../types/content";
import Icon from "../ui/Icon.astro";

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
const { t, language, localize } = getI18n(Astro.currentLocale);

const name = localize(item.shortTitle ?? item.title);
const issuer = item.organization ? localize(item.organization) : undefined;
const date = formatMonthYear(item.end ?? item.start, language);
const url = item.credential?.url;
---

{/* Certificación en formato compacto: icono, nombre corto, emisor, fecha y enlace a la credencial. */}
<div
  class="flex items-center gap-3 rounded-md border border-border bg-surface py-2 pr-2 pl-3 transition-[border-color] duration-200 hover:border-border-strong"
>
  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent" aria-hidden="true">
    <Icon name="check" />
  </span>
  <div class="flex min-w-0 flex-col">
    <h4 class="text-[0.95rem] leading-tight">{name}</h4>
    <p class="font-code text-[0.8125rem] text-fg-muted">
      {issuer}{issuer && " · "}{date}
    </p>
  </div>
  {
    url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.experience.credentialLabel(name, issuer)}
        class="grid size-9 shrink-0 place-items-center rounded-sm text-fg-muted transition-[color,background-color] duration-200 hover:bg-surface-hover hover:text-accent"
      >
        <Icon name="externalLink" />
      </a>
    )
  }
</div>
