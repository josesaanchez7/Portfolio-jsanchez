---
import { aboutFacts, profile } from "../../data/profile";
import { metrics } from "../../data/metrics";
import { getI18n } from "../../i18n";
import { formatInteger } from "../../lib/format";
import Section from "../layout/Section.astro";
import RichText from "../ui/RichText.astro";

const { language, t, localize } = getI18n(Astro.currentLocale);

/** Texto de una cifra: prefijo + número con separador de miles + sufijo. */
const display = (value: number, prefix = "", suffix = "") => `${prefix}${formatInteger(value, language)}${suffix}`;
---

<Section id="SobreMi">
  <div
    class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] items-start gap-[clamp(2rem,5vw,4rem)] max-nav:grid-cols-1"
  >
    <div class="flex max-w-[60ch] flex-col gap-5">
      <p class="text-[clamp(1.15rem,2.2vw,1.35rem)] leading-[1.5] text-fg">
        {t.about.intro({ fullName: profile.fullName })}
      </p>
      <p class="text-[1.05rem] text-fg-muted [&_strong]:font-semibold [&_strong]:text-fg">
        <RichText
          text={t.about.path({ job: localize(profile.currentJob), employer: profile.employer })}
        />
      </p>
      <p class="border-l-2 border-accent pl-4 text-[1.05rem] text-fg">{t.about.edge}</p>

      {/* Cifras con contador animado: el HTML ya trae el valor final y el script lo cuenta al verse. */}
      <ul class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3" data-metrics>
        {
          metrics.map((metric) => (
            <li class="rounded-md border border-border bg-surface px-5 py-4">
              <p class="font-heading text-[clamp(1.8rem,4vw,2.4rem)] leading-none font-bold tracking-[-0.02em] text-accent">
                <span class="sr-only">{display(metric.value, metric.prefix, metric.suffix)}</span>
                <span
                  aria-hidden="true"
                  data-count={metric.value}
                  data-prefix={metric.prefix ?? ""}
                  data-suffix={metric.suffix ?? ""}
                >
                  {display(metric.value, metric.prefix, metric.suffix)}
                </span>
              </p>
              <p class="mt-2 text-[0.88rem] leading-snug text-fg-muted">{localize(metric.label)}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="m-0 flex flex-col rounded-md border border-border bg-surface">
      {
        aboutFacts.map((fact) => (
          <div class="flex flex-col gap-[0.15rem] px-5 py-4 not-first:border-t not-first:border-border">
            <dt class="font-code text-[0.78rem] text-accent">{localize(fact.label)}</dt>
            <dd class="m-0 font-medium">{localize(fact.value)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<script>
  import { formatInteger } from "../../lib/format";
  import { DEFAULT_LANGUAGE, parseLanguage } from "../../lib/language";

  const DURATION_MS = 1400;

  const counters = [...document.querySelectorAll<HTMLElement>("[data-metrics] [data-count]")];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Con «reducir movimiento» (o sin contadores) se queda el valor final del HTML.
  if (counters.length > 0 && !reducedMotion) {
    const language = parseLanguage(document.documentElement.lang) ?? DEFAULT_LANGUAGE;

    const show = (counter: HTMLElement, value: number) => {
      counter.textContent = `${counter.dataset.prefix ?? ""}${formatInteger(value, language)}${counter.dataset.suffix ?? ""}`;
    };

    const count = (counter: HTMLElement) => {
      const target = Number(counter.dataset.count);
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / DURATION_MS);
        // Frena al final (ease-out cúbico).
        show(counter, Math.round(target * (1 - (1 - progress) ** 3)));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          count(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );

    for (const counter of counters) {
      show(counter, 0);
      observer.observe(counter);
    }
  }
</script>
